# Salin ke .env.local lalu isi. Jangan commit .env.local.

# mock = data contoh bertipe di memori (default, sampai skema Supabase siap)
# supabase = pakai project Supabase (wajib isi tiga variabel Supabase di bawah)
DATA_SOURCE=mock

# Wajib untuk build produksi bila DATA_SOURCE=mock. Minimal 32 karakter acak.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOCK_SESSION_SECRET=

# Supabase (region Singapore). Wajib bila DATA_SOURCE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API, hanya dipakai di server. Wajib bila USE_LLM=true.
ANTHROPIC_API_KEY=
USE_LLM=false
