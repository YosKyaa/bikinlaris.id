# Salin ke .env.local lalu isi. Jangan commit .env.local.

# mock = data contoh di memori (untuk demo dan uji coba)
# supabase = data asli di Supabase (wajib isi URL dan anon key di bawah)
DATA_SOURCE=mock

# Wajib untuk build produksi bila DATA_SOURCE=mock. Minimal 32 karakter acak.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOCK_SESSION_SECRET=

# Supabase. Wajib bila DATA_SOURCE=supabase. Keduanya kunci publik (bukan service role).
# Dasbor Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alamat situs untuk tautan yang dikirim lewat WhatsApp, contoh https://bikinlaris.id
# Kosong = diambil dari alamat yang sedang dibuka.
APP_URL=

# Tautan kuesioner hari ke-30 (SurveyMonkey). Kosong = tombol "Kirim kuesioner" nonaktif.
SURVEY_URL=
# Nama parameter kode peserta yang ditambahkan ke tautan kuesioner (?kode=BL-001).
# Kosongkan bila kuesioner tidak memakai variabel kustom.
SURVEY_CODE_PARAM=kode
# Tombol "Masuk dengan Google" untuk tim. Nyalakan (true) setelah provider Google aktif
# di Supabase (docs/SUPABASE.md). Diabaikan bila DATA_SOURCE=mock.
GOOGLE_LOGIN=false

# Tenggat kuesioner hari ke-30 (yyyy-mm-dd), untuk proyeksi di halaman Pantauan riset.
# Kosong = 2026-12-01.
RESEARCH_DEADLINE=

# ---------- AI (hanya dipakai di server, kunci tidak pernah ke browser) ----------
# AI_COACH=true  : "Tanya coach" di halaman paket UMKM.
# USE_LLM=true   : teks SOP ditulis ulang supaya menyebut nama usaha.
AI_COACH=false
USE_LLM=false

# Penyedia AI: openai atau anthropic. Ganti di sini tanpa mengubah kode.
AI_PROVIDER=openai

# OpenAI. Wajib bila AI_PROVIDER=openai dan AI_COACH/USE_LLM menyala (data asli).
OPENAI_API_KEY=
# Opsional. Bawaan: gpt-6-luna (paling hemat). gpt-6.1-terra lebih bagus menulis, ±10x harga.
OPENAI_MODEL=
# Opsional. Layanan lain yang memakai API /responses yang sama. Bawaan: https://api.openai.com/v1
OPENAI_BASE_URL=

# Claude (Anthropic). Wajib bila AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Opsional. Bawaan: claude-sonnet-5-5
ANTHROPIC_MODEL=
